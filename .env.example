# Required after production hosting is configured
SITE_URL=http://localhost:8000
COOKIE_SECURE=0
# PostgreSQL in production; leave blank for persistent SQLite development
DATABASE_URL=
SQLITE_PATH=data/vyora.sqlite3
SEED_DEMO=1
PORT=8000
# Mux server-only secrets; webhook URL: /api/webhooks/mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MAX_VIDEO_BYTES=1073741824
# Google Cloud Translation Basic v2 server-only key (restrict this key)
GOOGLE_TRANSLATION_KEY=
# Firebase public config is JSON; service account is secret JSON
FIREBASE_PUBLIC_CONFIG=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT=
# S3-compatible or AWS S3 image storage, NOT Cloudflare R2
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
# Separate PRIVATE bucket for public submission images (no public bucket policy)
PRIVATE_SUBMISSION_BUCKET=
# Advertising remains inactive until a certified CMP is integrated and tested
ADS_CONSENT_READY=0

# Public demo visibility is disabled by default, including existing demo records
ALLOW_DEMO_CONTENT=0
